#include <windows.h>
#include "resource.h"
IDI_APP ICON "app.ico"
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Darshan Corporation"
      VALUE "FileDescription", "Darshan File Manager"
      VALUE "FileVersion", "1.1.0.0"
      VALUE "InternalName", "DarshanFileManager"
      VALUE "LegalCopyright", "(c) 2026 Darshan Corporation"
      VALUE "OriginalFilename", "DarshanFileManager.exe"
      VALUE "ProductName", "Darshan File Manager"
      VALUE "ProductVersion", "1.1"
      VALUE "Comments", "Darshan File Manager 1.1, by Darshan Corporation"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
